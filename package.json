{
  "name": "dsh-weather-panel",
  "version": "1.2.4",
  "private": true,
  "description": "DeepSeek Harness UI plugin: a sidebar weather panel that auto-locates the current network, shows live meteorological parameters and a 3-day forecast from Open-Meteo. 深色/浅色主题自适应，零 API Key，纯浏览器端取数。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src",
    "scripts",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "basemap": "node scripts/build-basemap.mjs --scale 50m --tolerance 0.05 --decimals 2",
    "lint": "node --check index.js && node --check client.js && node --check scripts/build.mjs",
    "test": "node --test --test-isolation=none \"test/*.test.mjs\"",
    "check": "npm run build && npm run lint && npm test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "weather",
    "forecast",
    "open-meteo",
    "geolocation",
    "sidebar",
    "web-ui",
    "i18n",
    "zh",
    "en"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE_WITH_YOUR_GITHUB_USERNAME/dsh-weather-panel.git"
  },
  "bugs": {
    "url": "https://github.com/REPLACE_WITH_YOUR_GITHUB_USERNAME/dsh-weather-panel/issues"
  },
  "homepage": "https://github.com/REPLACE_WITH_YOUR_GITHUB_USERNAME/dsh-weather-panel#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
